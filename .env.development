NODE_TLS_REJECT_UNAUTHORIZED = 0
NEXTAUTH_SECRET = --------------------AUTH_SECRET----------------------
NEXT_PUBLIC_JWT_SECRET_KEY = ---------------JWT_SECRET_KEY---------------
GITHUB_ID = ""
GITHUB_SECRET = ""
NODE_OPTIONS = '--inspect'
NEXT_PUBLIC_VAPID_PUBLIC_KEY= ---------------------PUBLIC_KEY---------------------
VAPID_PRIVATE_KEY= ----------------------PRIVATE_KEY---------------------



# Backend API Configuration
# Copy this file to .env.local and update the values for your environment

NEXT_PUBLIC_API_BASE_URL=https://localhost:7134

# Frontend Domain Configuration
# Update these with your actual domain in production
NEXT_PUBLIC_FRONT_URL=http://localhost:3000


NEXTAUTH_URL=http://localhost:3000

# Node Environment
NODE_ENV=development

